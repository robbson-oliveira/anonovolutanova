# WordPress/WooCommerce (Store API e plugin anln-storefront-bridge). Hoje é o
# domínio principal; na virada passa a ser https://admin.anonovolutanova.com.br.
NEXT_PUBLIC_WP_URL=https://anonovolutanova.com.br

# URL canônica deste site (sitemap, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://anonovolutanova.com.br

# Id do produto variável "Agenda Ano Novo, Luta Nova 2027" no WooCommerce (só
# servidor). Com ele, /comprar lê preço, estoque e as variações Color/Clássica.
ANLN_PRODUCT_ID=

# Liga carrinho e checkout headless. Deixe "false" até a virada: sem isso,
# /comprar termina no pedido pelo WhatsApp mesmo com o produto configurado.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

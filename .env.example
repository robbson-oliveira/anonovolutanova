# WordPress/WooCommerce (Store API e plugin anln-storefront-bridge). Hoje é o
# domínio principal; na virada passa a ser https://admin.anonovolutanova.com.br.
NEXT_PUBLIC_WP_URL=https://anonovolutanova.com.br

# URL canônica deste site (sitemap, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://anonovolutanova.com.br

# Id do produto simples de cada edição da "Agenda Ano Novo, Luta Nova 2027" no
# WooCommerce (só servidor). Com os dois, o site lê preço, estoque e a imagem
# principal de cada edição.
ANLN_PRODUCT_COLOR=
ANLN_PRODUCT_CLASSIC=

# "true": a home mostra a página "Em breve" (Grupo VIP) no lugar da landing
# page. Lida pelo servidor a cada pedido: basta reiniciar para trocar.
ANLN_HOME_COMMING_SOON=false

# Senha de /home-dev: a landing page atrás de login enquanto a home é a
# "Em breve". Quem entra vê o site inteiro como depois da abertura (a home, a
# oferta, o carrinho e o checkout). Vazia: /home-dev não existe (404).
ANLN_HOME_DEV_PASSWORD=

# "true": abre /carrinho, a escolha da edição e o carrinho antes do checkout.
# Desligada, /carrinho leva à oferta da home. Também lida a cada pedido.
ANLN_PRECHECKOUT=false

# Liga carrinho e checkout headless. Deixe "false" até a virada: sem isso,
# /comprar termina no pedido pelo WhatsApp mesmo com o produto configurado.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Container do Google Tag Manager (GTM-XXXXXXX). Vazio: sem GTM; os eventos
# de e-commerce continuam no dataLayer, sem ninguém ouvindo.
NEXT_PUBLIC_GTM_ID=

# Número do chat do WhatsApp da página "Em breve", com DDI e DDD, só dígitos.
# Vazio: 5527992794290.
NEXT_PUBLIC_WHATSAPP_CHAT_NUMBER=5527992794290
